# ==============================================================================
# Genfolio — Environment Variables Template
# Copy this file to .env.local: cp .env.example .env.local
# ==============================================================================

# Port & Network
PORT=3000

# OpenRouter Configuration (Primary / Alternative AI Provider)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Google Gemini API Key (Optional — Free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Supabase Configuration (Optional — only needed for the "Deploy my portfolio" flow)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# PostgreSQL Database Configuration
DATABASE_URL=

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=
